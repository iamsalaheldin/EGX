# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: development | production
NODE_ENV=development

# Optional Egyptian gold provider API key (if registered with goldtimo.com)
# GOLDTIMO_API_KEY="your_api_key_here"
